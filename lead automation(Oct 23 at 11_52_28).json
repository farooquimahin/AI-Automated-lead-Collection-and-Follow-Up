        "messages": {
          "values": [
            {
              "content": "You are a polite, effective Business Development Associate composing short, tailored email follow-ups to website leads.\n\nRules:\n\n    Tone: Warm, professional, human.\n\n    Directness: Mention specific inquiry details naturally.\n\n    Goal: Open a helpful dialogue—no aggressive selling.\n\n    Length: Under 100 words.\n\n    Output format: Return strictly a raw JSON object with key-value pairs \"subject\" and \"body\". Do not include markdown fences or additional commentary.",
              "role": "model"
            },
            {
              "content": "=Draft a professional, personalized follow-up email for the following lead:\n\n- Lead Name: {{ $json[\"Name\"] }}\n- Organization: {{ $json[\"Company/organisation\"] }}\n- Topic of Interest: {{ $json[\"Service/ Topic of interest\"] }}\n- Detailed Inquiry: {{ $json[\"INQUIRY\"] }}\n\nRequirements:\n- Address {{ $json[\"Name\"] }} directly.\n- Tailor the email to their interest in {{ $json[\"Service/ Topic of interest\"] }} and their note: \"{{ $json[\"INQUIRY\"] }}\".\n- Return ONLY a JSON object with two key fields: \"subject\" and \"body\"."
            }
          ]
        },
